{
  auto_https disable_redirects
  default_sni {$FARM_TLS_IP:62.238.49.219}
}

{$SITE_ADDRESS} {
  reverse_proxy frontend:80
}

# Microphone capture requires a trusted secure context. Keep existing HTTP OBS
# URLs working while Caddy manages and renews the IP certificate automatically.
https://{$FARM_TLS_IP:62.238.49.219} {
  tls {
    issuer acme {
      dir https://acme-v02.api.letsencrypt.org/directory
      profile shortlived
    }
  }
  reverse_proxy frontend:80
}
