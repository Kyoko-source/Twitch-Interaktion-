{
  auto_https disable_redirects
  default_sni {$FARM_TLS_IP:62.238.49.219}
}

{$SITE_ADDRESS} {
  # Existing OBS sources keep their HTTP assets and read-only polling URLs.
  @legacyOBS {
    method GET HEAD
    path /overlays/* /api/live-news /api/purchase-alerts
  }
  handle @legacyOBS {
    reverse_proxy frontend:80
  }
  # All visitor pages and other requests use the trusted canonical origin.
  # Browsers preserve hash routes; {uri} preserves paths and query strings.
  handle {
    redir https://{$FARM_TLS_IP:62.238.49.219}{uri} 308
  }
}

# Caddy manages and renews the trusted IP certificate automatically.
https://{$FARM_TLS_IP:62.238.49.219} {
  tls {
    issuer acme {
      dir https://acme-v02.api.letsencrypt.org/directory
      profile shortlived
    }
  }
  reverse_proxy frontend:80
}
