{
  auto_https disable_redirects
  default_sni {$FARM_TLS_IP:62.238.49.219}
}

# Plain HTTP for every host (domain and IP).
{$SITE_ADDRESS} {
  # Existing OBS sources keep their HTTP assets and read-only polling URLs.
  @legacyOBS {
    method GET HEAD
    path /overlays/* /api/live-news /api/purchase-alerts
  }
  handle @legacyOBS {
    reverse_proxy frontend:80
  }
  # Everything else goes to the canonical HTTPS domain.
  # Browsers keep hash routes; {uri} keeps paths and query strings.
  handle {
    redir https://{$SITE_DOMAIN:my-aviary.de}{uri} 308
  }
}

# Canonical site. Caddy fetches and renews the Let's Encrypt certificate itself.
{$SITE_DOMAIN:my-aviary.de} {
  reverse_proxy frontend:80
}

www.{$SITE_DOMAIN:my-aviary.de} {
  redir https://{$SITE_DOMAIN:my-aviary.de}{uri} 308
}

# Old IP address: visitors opening the site are sent to the domain; stream
# overlays, stream pages, assets and the API keep working here so existing
# OBS/Streamlabs browser sources need no change.
https://{$FARM_TLS_IP:62.238.49.219} {
  tls {
    issuer acme {
      dir https://acme-v02.api.letsencrypt.org/directory
      profile shortlived
    }
  }
  @page path / /index.html
  redir @page https://{$SITE_DOMAIN:my-aviary.de}{uri} 308
  reverse_proxy frontend:80
}
