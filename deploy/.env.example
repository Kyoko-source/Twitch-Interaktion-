# Copy to deploy/.env on the server (never commit the real file).
SITE_ADDRESS=:80

SUPABASE_URL=https://dein-projekt.supabase.co
SUPABASE_ANON_KEY=dein-anon-key
SUPABASE_SERVICE_KEY=dein-service-role-key

# Both values are required. Generate them, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Without a JWT secret every backend restart logs all members out.
# Without an admin password (min. 12 characters) the admin area stays locked.
AVIARY_JWT_SECRET=
AVIARY_ADMIN_PASSWORD=

