config_version=5

[application]
config/name="After Play"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/NACHTWACHE - Kinderparadies"
config/custom_user_dir_name.web="godot/app_userdata/NACHTWACHE - Kinderparadies"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/description="Dreizehn Rundgaenge durch ein verlassenes Kinderparadies."
config/icon="res://assets/icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.025,0.04,0.045,1)

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_taa.web=false
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/volumetric_fog/volume_size=160
environment/volumetric_fog/volume_depth=96
environment/defaults/default_clear_color=Color(0.025,0.035,0.04,1)

[audio]
driver/enable_input=false

[physics]
common/physics_ticks_per_second=60
